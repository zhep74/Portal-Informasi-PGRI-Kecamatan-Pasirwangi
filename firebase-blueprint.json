{
  "entities": {
    "OrgProfile": {
      "title": "Organization Profile",
      "description": "Main organization profile and statistics for PGRI Pasirwangi",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "maxLength": 200 },
        "tingkat": { "type": "string", "maxLength": 100 },
        "kecamatan": { "type": "string", "maxLength": 100 },
        "kabupaten": { "type": "string", "maxLength": 100 },
        "provinsi": { "type": "string", "maxLength": 100 },
        "alamatSekretariat": { "type": "string", "maxLength": 500 },
        "email": { "type": "string", "maxLength": 200 },
        "nomorKontak": { "type": "string", "maxLength": 50 },
        "website": { "type": "string", "maxLength": 300 },
        "tahunBerdiri": { "type": "string", "maxLength": 10 },
        "logoUrl": { "type": "string", "maxLength": 2000 },
        "faviconUrl": { "type": "string", "maxLength": 2000 },
        "browserTitle": { "type": "string", "maxLength": 200 }
      },
      "required": ["nama", "kecamatan", "kabupaten", "provinsi"]
    },
    "VisiMisi": {
      "title": "Visi dan Misi",
      "description": "Vision, mission statements, objectives, and motto",
      "type": "object",
      "properties": {
        "visi": { "type": "string", "maxLength": 1000 },
        "moto": { "type": "string", "maxLength": 500 }
      },
      "required": ["visi", "moto"]
    },
    "SocialMediaLinks": {
      "title": "Social Media Links",
      "description": "Links to PGRI Pasirwangi social profiles",
      "type": "object",
      "properties": {
        "facebook": { "type": "string", "maxLength": 500 },
        "instagram": { "type": "string", "maxLength": 500 },
        "youtube": { "type": "string", "maxLength": 500 },
        "tiktok": { "type": "string", "maxLength": 500 },
        "whatsapp": { "type": "string", "maxLength": 500 },
        "telegram": { "type": "string", "maxLength": 500 },
        "website": { "type": "string", "maxLength": 500 }
      }
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Portal branding, hero details, and announcements",
      "type": "object",
      "properties": {
        "portalTitle": { "type": "string", "maxLength": 300 },
        "tagline": { "type": "string", "maxLength": 500 },
        "deskripsiHero": { "type": "string", "maxLength": 1500 },
        "pengumumanDarurat": { "type": "string", "maxLength": 1000 },
        "logoAplikasiUrl": { "type": "string", "maxLength": 2000 },
        "logoTitleUrl": { "type": "string", "maxLength": 2000 }
      },
      "required": ["portalTitle", "tagline"]
    },
    "SejarahItem": {
      "title": "Sejarah Item",
      "description": "Historical timeline milestones of PGRI Pasirwangi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tahun": { "type": "string", "maxLength": 50 },
        "judul": { "type": "string", "maxLength": 300 },
        "ringkasan": { "type": "string", "maxLength": 1000 },
        "isiLengkap": { "type": "string", "maxLength": 10000 },
        "gambarUrl": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "tahun", "judul", "ringkasan"]
    },
    "PengurusItem": {
      "title": "Pengurus Item",
      "description": "Member of PGRI Pasirwangi management committee",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 200 },
        "jabatan": { "type": "string", "maxLength": 200 },
        "kategori": { "type": "string", "enum": ["pimpinan", "sekretariat", "kebendaharaan", "bidang"] },
        "bidangNama": { "type": "string", "maxLength": 200 },
        "fotoUrl": { "type": "string", "maxLength": 2000 },
        "periode": { "type": "string", "maxLength": 100 },
        "nip": { "type": "string", "maxLength": 50 },
        "nuptk": { "type": "string", "maxLength": 50 },
        "unitKerja": { "type": "string", "maxLength": 200 },
        "keteranganSingkat": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "nama", "jabatan", "kategori", "periode"]
    },
    "ProgramKerjaItem": {
      "title": "Program Kerja Item",
      "description": "Work program details and progress",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 300 },
        "deskripsi": { "type": "string", "maxLength": 2000 },
        "bidang": { "type": "string", "maxLength": 200 },
        "target": { "type": "string", "maxLength": 300 },
        "waktuPelaksanaan": { "type": "string", "maxLength": 200 },
        "tahun": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Direncanakan", "Sedang Berjalan", "Selesai"] },
        "penanggungJawab": { "type": "string", "maxLength": 200 },
        "dokumentasiUrl": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "nama", "bidang", "tahun", "status"]
    },
    "KegiatanItem": {
      "title": "Kegiatan Item",
      "description": "Activities and documentation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 300 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "waktu": { "type": "string", "maxLength": 100 },
        "lokasi": { "type": "string", "maxLength": 300 },
        "deskripsi": { "type": "string", "maxLength": 5000 },
        "fotoUtama": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "nama", "tanggal", "lokasi", "deskripsi"]
    },
    "BeritaItem": {
      "title": "Berita Item",
      "description": "News article or announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 300 },
        "judul": { "type": "string", "maxLength": 300 },
        "ringkasan": { "type": "string", "maxLength": 1000 },
        "isi": { "type": "string", "maxLength": 20000 },
        "kategori": { "type": "string", "maxLength": 100 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "penulis": { "type": "string", "maxLength": 200 },
        "fotoUrl": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "judul", "ringkasan", "isi", "kategori", "tanggal", "penulis"]
    },
    "PrestasiItem": {
      "title": "Prestasi Item",
      "description": "Award and achievement showcase",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "namaPrestasi": { "type": "string", "maxLength": 300 },
        "tahun": { "type": "string", "maxLength": 20 },
        "penerima": { "type": "string", "maxLength": 200 },
        "kategori": { "type": "string", "maxLength": 100 },
        "tingkat": { "type": "string", "maxLength": 100 },
        "fotoPiagam": { "type": "string", "maxLength": 2000 },
        "deskripsi": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "namaPrestasi", "tahun", "penerima", "kategori", "tingkat"]
    },
    "GaleriItem": {
      "title": "Galeri Item",
      "description": "Photo or video media entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tipe": { "type": "string", "enum": ["foto", "video"] },
        "judul": { "type": "string", "maxLength": 300 },
        "deskripsi": { "type": "string", "maxLength": 1000 },
        "url": { "type": "string", "maxLength": 2000 },
        "youtubeId": { "type": "string", "maxLength": 100 },
        "thumbnailUrl": { "type": "string", "maxLength": 2000 },
        "kategori": { "type": "string", "maxLength": 100 },
        "tahun": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "tipe", "judul", "url", "kategori", "tahun"]
    },
    "KalenderItem": {
      "title": "Kalender Item",
      "description": "Agenda and calendar events",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "judul": { "type": "string", "maxLength": 300 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "jamMulai": { "type": "string", "maxLength": 50 },
        "jamSelesai": { "type": "string", "maxLength": 50 },
        "lokasi": { "type": "string", "maxLength": 300 },
        "penanggungJawab": { "type": "string", "maxLength": 200 },
        "deskripsi": { "type": "string", "maxLength": 2000 },
        "kategori": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "judul", "tanggal", "lokasi", "kategori", "status"]
    },
    "LayananItem": {
      "title": "Layanan Item",
      "description": "Service catalogs for teachers and members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 300 },
        "deskripsi": { "type": "string", "maxLength": 2000 },
        "ikon": { "type": "string", "maxLength": 100 },
        "kontakPic": { "type": "string", "maxLength": 200 },
        "estimasiHari": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "nama", "deskripsi", "ikon", "kontakPic", "estimasiHari"]
    },
    "PendaftaranItem": {
      "title": "Pendaftaran Item",
      "description": "Teacher membership application submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nomorPendaftaran": { "type": "string", "maxLength": 100 },
        "tanggalDaftar": { "type": "string", "maxLength": 50 },
        "namaLengkap": { "type": "string", "maxLength": 200 },
        "nikNip": { "type": "string", "maxLength": 100 },
        "nuptk": { "type": "string", "maxLength": 100 },
        "tempatTanggalLahir": { "type": "string", "maxLength": 200 },
        "jenisKelamin": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "instansi": { "type": "string", "maxLength": 200 },
        "jabatan": { "type": "string", "maxLength": 200 },
        "mapel": { "type": "string", "maxLength": 200 },
        "alamat": { "type": "string", "maxLength": 500 },
        "noWhatsApp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 200 },
        "kecamatan": { "type": "string", "maxLength": 100 },
        "statusKepegawaian": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Baru", "Diverifikasi", "Diterima", "Ditolak"] },
        "catatanAdmin": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "nomorPendaftaran", "tanggalDaftar", "namaLengkap", "noWhatsApp", "instansi", "status"]
    },
    "AspirasiItem": {
      "title": "Aspirasi Item",
      "description": "Teacher and public feedback/aspiration submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tiketId": { "type": "string", "maxLength": 100 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "nama": { "type": "string", "maxLength": 200 },
        "noWhatsApp": { "type": "string", "maxLength": 50 },
        "instansi": { "type": "string", "maxLength": 200 },
        "kategori": { "type": "string", "maxLength": 100 },
        "judul": { "type": "string", "maxLength": 300 },
        "isi": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["Diterima", "Diproses", "Selesai"] },
        "responAdmin": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "tiketId", "tanggal", "judul", "isi", "status"]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Verified administrator profile with manage privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin"] },
        "nama": { "type": "string", "maxLength": 200 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Singleton configuration docs (profile, visiMisi, socialMedia, siteSettings)"
    },
    "/sejarah/{sejarahId}": {
      "schema": "SejarahItem",
      "description": "Historical timeline milestones of PGRI Pasirwangi"
    },
    "/pengurus/{pengurusId}": {
      "schema": "PengurusItem",
      "description": "Management committee member documents"
    },
    "/programKerja/{programKerjaId}": {
      "schema": "ProgramKerjaItem",
      "description": "Work program records"
    },
    "/kegiatan/{kegiatanId}": {
      "schema": "KegiatanItem",
      "description": "Activities and documentation records"
    },
    "/berita/{beritaId}": {
      "schema": "BeritaItem",
      "description": "News articles and announcements"
    },
    "/prestasi/{prestasiId}": {
      "schema": "PrestasiItem",
      "description": "Award and achievement documents"
    },
    "/galeri/{galeriId}": {
      "schema": "GaleriItem",
      "description": "Photo and video media records"
    },
    "/kalender/{kalenderId}": {
      "schema": "KalenderItem",
      "description": "Calendar events records"
    },
    "/layanan/{layananId}": {
      "schema": "LayananItem",
      "description": "Service catalog entries"
    },
    "/pendaftaran/{pendaftaranId}": {
      "schema": "PendaftaranItem",
      "description": "Member registration applications"
    },
    "/aspirasi/{aspirasiId}": {
      "schema": "AspirasiItem",
      "description": "Feedback and inquiry submissions"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized administrator whitelist"
    }
  }
}
